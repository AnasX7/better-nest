# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# CORS & Trusted Origins (comma-separated)
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173"
