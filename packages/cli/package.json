{
  "name": "create-better-nest",
  "version": "0.1.0",
  "description": "A modern CLI tool for scaffolding production-grade NestJS applications with TypeScript, Fastify/Express, Drizzle ORM, and Better Auth",
  "author": "Anas <anas@example.com>",
  "license": "MIT",
  "homepage": "https://github.com/AnasX7/better-nest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnasX7/better-nest.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AnasX7/better-nest/issues"
  },
  "keywords": [
    "nestjs",
    "better-nest",
    "cli",
    "scaffold",
    "template",
    "typescript",
    "fastify",
    "express",
    "drizzle-orm",
    "better-auth",
    "scalar",
    "nextjs",
    "tanstack",
    "bun",
    "turborepo"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "better-nest": "./dist/index.cjs",
    "create-better-nest": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "dev": "tsdown --watch",
    "cli": "bun run src/index.ts",
    "start": "node dist/index.cjs",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "giget": "^3.3.1",
    "picocolors": "^1.1.1",
    "tsdown": "^0.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
